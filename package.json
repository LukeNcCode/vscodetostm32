{
  "name": "vscodetostm32",
  "displayName": "VscodeToStm32",
  "description": "在 VSCode 中基于 CMake 一键编译、烧录与调试 STM32（JLink / STLink / DAPLink）。",
  "version": "0.1.1",
  "publisher": "vscodetostm32",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "stm32",
    "cmake",
    "jlink",
    "stlink",
    "daplink",
    "openocd",
    "arm",
    "embedded"
  ],
  "activationEvents": [
    "workspaceContains:**/CMakeLists.txt"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscodetostm32.build",
        "title": "编译（Build）",
        "category": "STM32",
        "icon": "$(tools)"
      },
      {
        "command": "vscodetostm32.flash",
        "title": "烧录（Flash）",
        "category": "STM32",
        "icon": "$(zap)"
      },
      {
        "command": "vscodetostm32.buildAndFlash",
        "title": "编译并烧录（Build & Flash）",
        "category": "STM32",
        "icon": "$(run-all)"
      },
      {
        "command": "vscodetostm32.erase",
        "title": "全片擦除（Erase Chip）",
        "category": "STM32",
        "icon": "$(trash)"
      },
      {
        "command": "vscodetostm32.reset",
        "title": "复位并运行（Reset & Run）",
        "category": "STM32",
        "icon": "$(debug-restart)"
      },
      {
        "command": "vscodetostm32.probe",
        "title": "检测探针连接（Probe）",
        "category": "STM32",
        "icon": "$(plug)"
      },
      {
        "command": "vscodetostm32.selectProbe",
        "title": "选择烧录器（Select Probe）",
        "category": "STM32",
        "icon": "$(list-selection)"
      },
      {
        "command": "vscodetostm32.selectDevice",
        "title": "设置芯片型号（Set Device）",
        "category": "STM32",
        "icon": "$(chip)"
      },
      {
        "command": "vscodetostm32.generateDebugConfig",
        "title": "生成调试配置（Generate launch.json）",
        "category": "STM32",
        "icon": "$(debug-alt)"
      },
      {
        "command": "vscodetostm32.quickSetup",
        "title": "快速配置（Quick Setup）",
        "category": "STM32",
        "icon": "$(wand)"
      },
      {
        "command": "vscodetostm32.diagnosePaths",
        "title": "诊断工具路径（Diagnose Paths）",
        "category": "STM32",
        "icon": "$(search)"
      },
      {
        "command": "vscodetostm32.showOutput",
        "title": "显示输出日志（Show Output）",
        "category": "STM32",
        "icon": "$(output)"
      }
    ],
    "configuration": {
      "title": "VscodeToStm32",
      "properties": {
        "vscodetostm32.probe": {
          "type": "string",
          "enum": [
            "jlink",
            "stlink",
            "daplink"
          ],
          "enumDescriptions": [
            "SEGGER J-Link，通过 JLink.exe CommanderScript 烧录",
            "ST-LINK，通过 STM32CubeProgrammer CLI 烧录",
            "CMSIS-DAP / DAPLink，通过 OpenOCD 烧录"
          ],
          "default": "stlink",
          "markdownDescription": "当前使用的烧录器。烧录前扩展会做一次连接探测校验，不匹配时给出提示。",
          "order": 1
        },
        "vscodetostm32.device": {
          "type": "string",
          "default": "",
          "markdownDescription": "目标芯片型号，例如 `STM32F407ZG`。用于 J-Link 的 `-device` 参数以及推导 OpenOCD 的 target 脚本（`stm32f4x.cfg`）。留空时 J-Link 交由 SEGGER 自动识别。",
          "order": 2
        },
        "vscodetostm32.interface": {
          "type": "string",
          "enum": [
            "SWD",
            "JTAG"
          ],
          "default": "SWD",
          "description": "调试接口类型。",
          "order": 3
        },
        "vscodetostm32.speed": {
          "type": "number",
          "default": 4000,
          "description": "接口速度（kHz）。",
          "order": 4
        },
        "vscodetostm32.elfPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "固件 `.elf` 路径。留空时自动从 CMake Tools 的构建产物中推导。",
          "order": 5
        },
        "vscodetostm32.buildTarget": {
          "type": "string",
          "default": "",
          "description": "构建目标。留空时使用 CMake Tools 当前选中的目标。",
          "order": 6
        },
        "vscodetostm32.buildBeforeFlash": {
          "type": "boolean",
          "default": false,
          "description": "执行烧录前自动先编译一次。",
          "order": 7
        },
        "vscodetostm32.verifyAfterFlash": {
          "type": "boolean",
          "default": true,
          "description": "烧录后校验 Flash 内容（STLink / DAPLink 生效）。",
          "order": 8
        },
        "vscodetostm32.resetAfterFlash": {
          "type": "boolean",
          "default": true,
          "description": "烧录完成后复位并运行目标程序。",
          "order": 9
        },
        "vscodetostm32.probeCheck": {
          "type": "string",
          "enum": [
            "warn",
            "strict",
            "off"
          ],
          "enumDescriptions": [
            "探测失败仅警告，仍继续烧录",
            "探测失败即中止并提示",
            "跳过探测，直接烧录"
          ],
          "default": "warn",
          "markdownDescription": "烧录前的探针连接校验策略。",
          "order": 10
        },
        "vscodetostm32.armToolchainPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "ARM 交叉编译工具链 `bin` 目录。留空时依赖系统 PATH 中的 `arm-none-eabi-gcc`。",
          "order": 11
        },
        "vscodetostm32.cubeProgrammerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`STM32_Programmer_CLI` 可执行文件路径。留空时自动探测常见安装位置与 PATH。",
          "order": 12
        },
        "vscodetostm32.openocdPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`openocd` 可执行文件路径。留空时自动探测常见安装位置与 PATH。",
          "order": 13
        },
        "vscodetostm32.jlinkPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`JLink.exe` 可执行文件路径。留空时自动探测 `C:/Program Files/SEGGER` 下最新版本与 PATH。",
          "order": 14
        },
        "vscodetostm32.jlinkSerialNo": {
          "type": "string",
          "default": "",
          "description": "J-Link 序列号（多探针时指定，单探针留空）。",
          "order": 15
        },
        "vscodetostm32.debugServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "调试用的 GDB Server 路径。留空时按探针自动推导（J-Link 用同目录 `JLinkGDBServerCL.exe`，其它用 `openocd`）。",
          "order": 16
        },
        "vscodetostm32.debugConfigName": {
          "type": "string",
          "default": "STM32 Debug (VscodeToStm32)",
          "description": "生成的 cortex-debug 配置名称。",
          "order": 17
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vscodetostm32.showOutput"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "arm-gcc",
        "owner": "cpp",
        "source": "gcc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "vscodetostm32",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "build",
              "flash",
              "erase",
              "reset"
            ],
            "description": "要执行的动作。"
          }
        },
        "required": [
          "action"
        ]
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
