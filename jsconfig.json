{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "checkJs": true, /* Typecheck .js files. */
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha",
        ],
    },
    "include": [
        "extension.js",
        "src/**/*.js",
        "test/**/*.js",
    ],
    "exclude": [
        "node_modules",
        ".vscode-test",
    ]
}
